<Window x:Class="HybridPortfolio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hybrid Portfolio - Virtual Inspection Cell"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="700"
        Background="#F3F6FB">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="360" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D6DEEA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontWeight="SemiBold"
                               Text="Mode" />
                    <ComboBox x:Name="CmbRunMode"
                              Width="120"
                              Margin="0,0,12,0"
                              SelectionChanged="CmbRunMode_SelectionChanged">
                        <ComboBoxItem Content="Sim" IsSelected="True" />
                        <ComboBoxItem Content="Vision" />
                    </ComboBox>
                    <Button x:Name="BtnRunOne"
                            Content="Run One Cycle"
                            Width="130"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Click="BtnRunOne_Click" />
                    <Button x:Name="BtnAutoStart"
                            Content="Start Auto Run"
                            Width="130"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Click="BtnAutoStart_Click" />
                    <Button x:Name="BtnAutoStop"
                            Content="Stop Auto Run"
                            Width="130"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Click="BtnAutoStop_Click" />
                    <Button x:Name="BtnClearLog"
                            Content="Clear History"
                            Width="120"
                            Padding="8,4"
                            Click="BtnClearLog_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#4B5563"
                               Text="Pipeline: IDLE -> INSPECT -> RESULT -> IDLE" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <TextBlock FontSize="12"
                                   Foreground="#374151"
                                   Text="Total: " />
                        <TextBlock x:Name="TxtTotalCount"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="0" />
                        <TextBlock Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="#374151"
                                   Text="OK Rate: " />
                        <TextBlock x:Name="TxtOkRate"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#166534"
                                   Text="0.0%" />
                        <TextBlock Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="#374151"
                                   Text="NG Rate: " />
                        <TextBlock x:Name="TxtNgRate"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#991B1B"
                                   Text="0.0%" />
                        <TextBlock Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="#374151"
                                   Text="Barcode Fail: " />
                        <TextBlock x:Name="TxtBarcodeFailRate"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#92400E"
                                   Text="0.0%" />
                    </StackPanel>
                    <TextBlock x:Name="TxtReportFiles"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#6B7280"
                               Text="CSV: -, JSONL: -" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D6DEEA"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="PLC State"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0" />
                        <Border x:Name="PlcStateBadge"
                                Padding="10,4"
                                CornerRadius="12"
                                Background="#E5E7EB">
                            <TextBlock x:Name="TxtPlcState"
                                       Text="IDLE"
                                       FontWeight="Bold"
                                       Foreground="#111827" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,8">
                        <Canvas x:Name="ObjectCanvas"
                                Width="520"
                                Height="220"
                                Background="#FFFFFF" />
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,8,3"
                                   FontWeight="SemiBold"
                                   Text="Object ID" />
                        <TextBlock x:Name="TxtObjectId"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="0,0,0,3"
                                   Text="-" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,0,8,3"
                                   FontWeight="SemiBold"
                                   Text="Shape Kind" />
                        <TextBlock x:Name="TxtShapeKind"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,0,0,3"
                                   Text="-" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,0,8,3"
                                   FontWeight="SemiBold"
                                   Text="Ground Truth" />
                        <TextBlock x:Name="TxtGroundTruth"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,0,0,3"
                                   Text="-" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Margin="0,0,8,0"
                                   FontWeight="SemiBold"
                                   Text="Captured At" />
                        <TextBlock x:Name="TxtCapturedAt"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   Text="-" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#D6DEEA"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               FontWeight="SemiBold"
                               Margin="0,0,8,6"
                               Text="Barcode" />
                    <TextBlock x:Name="TxtBarcodeValue"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,0,6"
                               Text="-" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               FontWeight="SemiBold"
                               Margin="0,0,8,6"
                               Text="Barcode Conf." />
                    <TextBlock x:Name="TxtBarcodeConfidence"
                               Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,0,0,6"
                               Text="-" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               FontWeight="SemiBold"
                               Margin="0,0,8,6"
                               Text="Shape Result" />
                    <TextBlock x:Name="TxtShapeResult"
                               Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,0,0,6"
                               Text="-" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               FontWeight="SemiBold"
                               Margin="0,0,8,6"
                               Text="Shape Score" />
                    <TextBlock x:Name="TxtShapeScore"
                               Grid.Row="3"
                               Grid.Column="1"
                               Margin="0,0,0,6"
                               Text="-" />

                    <Border x:Name="FinalResultCard"
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#D1D5DB"
                            Background="#F9FAFB">
                        <StackPanel>
                            <TextBlock Text="Final Decision"
                                       FontWeight="SemiBold"
                                       Foreground="#374151" />
                            <TextBlock x:Name="TxtFinalResult"
                                       Margin="0,6,0,4"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Text="-" />
                            <TextBlock x:Name="TxtReason"
                                       Text="Press 'Run One Cycle' to start."
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D6DEEA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Inspection History"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid x:Name="HistoryGrid"
                          Grid.Row="1"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F8FAFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="140" />
                        <DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="130" />
                        <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="110" />
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="260" />
                        <DataGridTextColumn Header="Shape Result" Binding="{Binding ShapeResult}" Width="150" />
                        <DataGridTextColumn Header="Final" Binding="{Binding Final}" Width="90" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
